# Language model: any OpenAI-compatible endpoint. Groq's free tier is the default.
# Free key: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# JUDGE_MODEL=openai/gpt-oss-120b
# LLM_STRUCTURED_METHOD=json_schema   # use function_calling if the provider lacks structured outputs

# Langfuse (optional: without these keys the agent runs untraced).
# Project settings → API keys. EU region: https://cloud.langfuse.com · US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
